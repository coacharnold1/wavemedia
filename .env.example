# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=https://wavemedianj.com

# Email delivery for contact/inquiry forms (Phase 3)
# Both RESEND_API_KEY and INQUIRY_TO_EMAIL (comma-separated ok) are required to send
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=
# INQUIRY_FROM_EMAIL=  (must be a verified Resend domain; defaults to the Resend test sender)

# HoneyBook / CRM (optional)
# HONEYBOOK_API_KEY=

# AI features (reply drafts now; chatbot later). Any OpenAI-compatible API.
# Drafts are emailed to the owner only, never sent to clients automatically.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Analytics
# NEXT_PUBLIC_GA_ID=
